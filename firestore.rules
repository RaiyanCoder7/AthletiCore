rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Authentication / role helpers
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function userRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isAthlete() {
      return isAuthenticated()
        && userExists(request.auth.uid)
        && userRole(request.auth.uid) == 'athlete';
    }

    function isCoach() {
      return isAuthenticated()
        && userExists(request.auth.uid)
        && userRole(request.auth.uid) == 'coach';
    }

    function isManager() {
      return isAuthenticated()
        && userExists(request.auth.uid)
        && userRole(request.auth.uid) == 'manager';
    }

    function isConnectedCoach(athleteId) {
      return isCoach()
        && exists(/databases/$(database)/documents/users/$(athleteId))
        && get(/databases/$(database)/documents/users/$(athleteId)).data.role == 'athlete'
        && get(/databases/$(database)/documents/users/$(athleteId)).data.coachIds.hasAny([request.auth.uid]);
    }

    function ownsTeam(teamId) {
      return isCoach()
        && exists(/databases/$(database)/documents/teams/$(teamId))
        && get(/databases/$(database)/documents/teams/$(teamId)).data.coachId == request.auth.uid;
    }

    // ============================================================
    // Users
    // ============================================================
    match /users/{userId} {

      // Public registration is intentionally limited to athletes.
      // Coach/manager accounts must be provisioned by a trusted
      // backend/Admin SDK process.
      allow create: if isOwner(userId)
        && request.resource.data.role == 'athlete'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasAll(['name', 'email', 'role', 'createdAt'])
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'role', 'createdAt'
        ]);

      // Own profile, or an athlete profile belonging to this coach.
      allow read: if isOwner(userId) || isConnectedCoach(userId);

      // A user may edit their own profile, but cannot change
      // authorization/relationship fields from the client.
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role',
          'coachIds',
          'teamId',
          'teamName',
          'email'
        ]);

      // A connected coach may only update coach-owned operational
      // fields on an athlete profile.
      allow update: if isConnectedCoach(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.coachIds == resource.data.coachIds
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clearance',
          'availability',
          'status',
          'notes',
          'workload',
          'protocolNote',
          'coachNotes',
          'lastActive',
          'updatedAt'
        ]);

      allow delete: if isOwner(userId);

      // ----------------------------------------------------------
      // Athlete-owned data + connected coach read/write
      // ----------------------------------------------------------
      match /trainingSessions/{sessionId} {
        allow read, write: if isOwner(userId) || isConnectedCoach(userId);
      }

      match /performanceTests/{testId} {
        allow read, write: if isOwner(userId) || isConnectedCoach(userId);
      }

      match /goals/{goalId} {
        allow read, write: if isOwner(userId) || isConnectedCoach(userId);
      }

      match /calendarEvents/{eventId} {
        allow read, write: if isOwner(userId) || isConnectedCoach(userId);
      }

      match /recoveryEntries/{entryId} {
        allow read, write: if isOwner(userId) || isConnectedCoach(userId);
      }

      match /achievements/{achievementId} {
        allow read, write: if isOwner(userId) || isConnectedCoach(userId);
      }

      match /matches/{matchId} {
        allow read, write: if isOwner(userId) || isConnectedCoach(userId);
      }
    }

    // ============================================================
    // Coach training planner
    // ============================================================
    match /training_sessions/{sessionId} {
      allow read: if isAuthenticated()
        && (
          (resource.data.coachId == request.auth.uid)
          || (
            resource.data.teamId != null
            && exists(/databases/$(database)/documents/teams/$(resource.data.teamId))
            && get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.athleteIds.hasAny([request.auth.uid])
          )
        );

      allow create: if isCoach()
        && request.resource.data.coachId == request.auth.uid;

      allow update, delete: if isCoach()
        && resource.data.coachId == request.auth.uid
        && request.resource.data.coachId == request.auth.uid;
    }

    // ============================================================
    // Teams
    // ============================================================
    match /teams/{teamId} {
      // Coach can access only their own teams.
      // Athlete can read a team only when already a member.
      allow read: if ownsTeam(teamId)
        || (
          isAthlete()
          && resource.data.athleteIds.hasAny([request.auth.uid])
        );

      allow create: if isCoach()
        && request.resource.data.coachId == request.auth.uid;

      allow update: if ownsTeam(teamId)
        && request.resource.data.coachId == resource.data.coachId
        && request.resource.data.coachId == request.auth.uid;

      allow delete: if ownsTeam(teamId);

      // ----------------------------------------------------------
      // Invitations
      // ----------------------------------------------------------
      match /invitations/{invitationId} {
        allow read, update, delete: if ownsTeam(teamId);

        allow create: if ownsTeam(teamId)
          && request.resource.data.invitedBy == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.email is string
          && request.resource.data.email.size() > 0;

        // Direct client-side invitation acceptance is deliberately
        // not allowed. Acceptance should be handled by a trusted
        // backend/Cloud Function so coachIds and team membership
        // cannot be forged.
      }

      // ----------------------------------------------------------
      // Team matches
      // ----------------------------------------------------------
      match /matches/{matchId} {
        allow read, write: if ownsTeam(teamId);
      }
    }

    // ============================================================
    // Default deny
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}